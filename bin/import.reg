[SYSTEM]
MOUSE="Mouse Settings"
CURSORS="System Cursors"
LANGUAGE="Language Settings"
FILETYPES="File Associations"
GRAPHICS="Graphics Options (resolution, colour depth, etc)"
STARTUP="Startup Applications"

[SYSTEM/MOUSE]
SPEED=2
DBLCLICK=500

[SYSTEM/CURSORS]
ARROW="cursors/arrow.cur"
MOVE="cursors/move.cur"
GROW="cursors/size2.cur"
TEXT="cursors/beam.cur"
CLOCK="cursors/busy.cur"
PENCIL="cursors/pen.cur"
STOP="cursors/no.cur"
SCRUP="cursors/size1.cur"
SCDDN="cursors/size2.cur"
SCRLF="cursors/size3.cur"
SCRRG="cursors/size4.cur"

[SYSTEM/LANGUAGE]
LNGFILE="lng.ini"
LNG="en"

[SYSTEM/FILETYPES]
TXT="Text files"
MP3="MP3 file"
MP2="MP2 file"
MOD="MOD file"
S3M="S3M (MOD) file"
MID="MIDI file"
XM="XM (MOD) file"
IT="IT (MOD) file"
JGM="JGMOD file"
WAV="WAVE file"
HLP="Help File"
EXE="DOS executable"
COM="DOS command"
BAT="DOS batch file"
FOLDER="Folder"

[SYSTEM/FILETYPES/TXT]
LOADER="/programs/seal/smalldit.s2a"
ICON16="bmp/icons/txt.ico,16"
ICON32="bmp/icons/txt.ico,32"
MIME="text/plain"

[SYSTEM/FILETYPES/MP3]
LOADER="/programs/seal/player.s2a"
ICON16="bmp/icons/snd.ico,16"
ICON32="bmp/icons/snd.ico,32"
MIME="audio/mpeg"

[SYSTEM/FILETYPES/MP2]
LOADER="/programs/seal/player.s2a"
ICON16="bmp/icons/snd.ico,16"
ICON32="bmp/icons/snd.ico,32"
MIME="audio/mpeg"

[SYSTEM/FILETYPES/MOD]
LOADER="/programs/seal/player.s2a"
ICON16="bmp/icons/snd.ico,16"
ICON32="bmp/icons/snd.ico,32"
MIME="application/x-multiplan"
; The above is what Winamp sets the MIME type for .MOD to, so we'll do the same, odd
; as it may be...

[SYSTEM/FILETYPES/S3M]
LOADER="/programs/seal/player.s2a"
ICON16="bmp/icons/snd.ico,16"
ICON32="bmp/icons/snd.ico,32"

[SYSTEM/FILETYPES/MID]
