# an original look skin for SEAL >=2.00.11
# checkboxes need work for future seal versions.

[btup]
bmp="skin/lagoon/btnov.png"
ax=4
ay=4
by=4
bx=4
text="255,255,255"

[btnotover]
bmp="skin/lagoon/btn.png"
ax=4
ay=4
by=4
bx=4
text="255,255,255"

[btdown]
bmp="skin/lagoon/btndwn.png"
ax=4
ay=4
by=4
bx=4
text="255,255,255"

[window_body]
ax=2
ay=2
by=2
bx=2
bmp="skin/lagoon/window.png"

[window]
bmp="skin/lagoon/top_pass.png"
ax=3
ay=3
by=3
bx=3
text="255,255,255"

[window_passive]
bmp="skin/lagoon/top.png"
ax=3
ay=3
by=3
bx=3
text="0,0,0"

[checkbox_up]
bmp="skin/lagoon/uncheck.png"
ax=0
ay=0
bx=13
by=11
text="0,0,0"


[checkbox_down]
bmp="skin/lagoon/checkd.png"
ax=0
ay=0
bx=13
by=11
text="0,0,0"


[checkbox_checked]
bmp="skin/lagoon/check.png"
ax=0
ay=0
bx=13
by=11
text="0,0,0"


[checkbox_greyed]
bmp="skin/lagoon/checkd.png"
ax=0
ay=0
bx=13
by=11
text="0,0,0"

[checkbox_greyed_checked]
bmp="skin/lagoon/checkd.png"
ax=0
ay=0
bx=13
by=11
text="0,0,0"

