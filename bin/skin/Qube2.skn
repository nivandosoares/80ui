# Qube Theme 2.1
# A QubeOS style theme for SEAL
# button graphics based on Aqua Light Blue GTK+ skin.
# checkboxes and widgets now skinned.

[btup]
bmp="skin/qube2/qbov.png"
ax=5
ay=5
by=7
bx=7
text="0,0,0"

