# Qube Theme 2.0
# A QubeOS style theme for SEAL
# button graphics based on Aqua Light Blue GTK+ skin.
[btup]
bmp="skin/qube/qbov.png"
ax=5
ay=5
by=7
bx=7
text="0,0,0"

[btnotover]
bmp="skin/qube/qb.png"
ax=5
ay=5
by=7
bx=7
text="0,0,0"

[btdown]
bmp="skin/qube/qbdwn.png"
ax=6
ay=6
by=6
bx=6
text="255,255,255"

[window_body]
ax=6
ay=6
by=6
bx=6
bmp="skin/qube/back.png"

[window]
bmp="skin/qube/top_pass.png"
ax=2
ay=2
by=2
bx=2

[window_passive]
bmp="skin/qube/top.png"
ax=2
ay=2
by=2
bx=2
text="255,255,255"

[widget_help]
bmp="skin/qube/help.png"
ax=0
ay=0
bx=13
by=12

[widget_minimize]
bmp="skin/qube/minimize.png"
ax=0
ay=0
bx=13
by=12

[widget_maximize]
bmp="skin/qube/maximize.png"
ax=0
ay=0
bx=13
by=12

[widget_close]
bmp="skin/qube/close.png"
ax=0
ay=0
bx=13
by=12

[checkbox_up]     // unused
bmp="skin/qube/uncheck.png"
ax=0
ay=0
bx=12
by=11

[checkbox_down]
bmp="skin/qube/uncheckd.png"
ax=0
ay=0
bx=12
by=11

[checkbox_checked]
bmp="skin/qube/check.png"
ax=0
ay=0
bx=12
by=11

[checkbox_greyed]
bmp="skin/qube/uncheckd.png"
ax=0
ay=0
bx=12
by=11

[checkbox_greyed_checked]
bmp="skin/qube/checkd.png"
ax=0
ay=0
bx=12
by=11

